<sdf version="1.9">
  <world name="margdrishti_world">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.2 -0.8</direction>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </visual>
      </link>
    </model>

    <model name="MARGDRISHTI">
      <pose>0 0 0.18 0 0 0</pose>
      <link name="chassis">
        <inertial><mass>5</mass><inertia>
          <ixx>0.06</ixx><iyy>0.09</iyy><izz>0.12</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia></inertial>
        <collision name="body_collision"><geometry><box><size>0.42 0.30 0.10</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.42 0.30 0.10</size></box></geometry><material><ambient>0.12 0.25 0.35 1</ambient><diffuse>0.12 0.25 0.35 1</diffuse></material></visual>
      </link>

      <link name="left_front_wheel">
        <pose>0.14 0.19 -0.06 1.5708 0 0</pose>
        <inertial><mass>0.3</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.075</radius><length>0.045</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.075</radius><length>0.045</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient></material></visual>
      </link>
      <link name="right_front_wheel">
        <pose>0.14 -0.19 -0.06 1.5708 0 0</pose>
        <inertial><mass>0.3</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.075</radius><length>0.045</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.075</radius><length>0.045</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient></material></visual>
      </link>
      <link name="left_rear_wheel">
        <pose>-0.14 0.19 -0.06 1.5708 0 0</pose>
        <inertial><mass>0.3</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.075</radius><length>0.045</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.075</radius><length>0.045</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient></material></visual>
      </link>
      <link name="right_rear_wheel">
        <pose>-0.14 -0.19 -0.06 1.5708 0 0</pose>
        <inertial><mass>0.3</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.075</radius><length>0.045</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.075</radius><length>0.045</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient></material></visual>
      </link>

      <joint name="front_left_joint" type="revolute"><parent>chassis</parent><child>left_front_wheel</child></joint>
      <joint name="front_right_joint" type="revolute"><parent>chassis</parent><child>right_front_wheel</child></joint>
      <joint name="rear_left_joint" type="revolute"><parent>chassis</parent><child>left_rear_wheel</child></joint>
      <joint name="rear_right_joint" type="revolute"><parent>chassis</parent><child>right_rear_wheel</child></joint>


      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <right_joint>front_left_joint</right_joint>
<right_joint>rear_left_joint</right_joint>
<left_joint>front_right_joint</left_joint>
<left_joint>rear_right_joint</left_joint><wheel_separation>0.38</wheel_separation>
        <wheel_radius>0.075</wheel_radius>
        <topic>/cmd_vel</topic>
      </plugin>
      <link name="camera_mount">
        <pose>0.13 0 0.12 0 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="mount"><geometry><box><size>0.08 0.08 0.08</size></box></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
        <sensor name="road_camera" type="camera">
          <pose>0.05 0 0.03 0 0.15 0</pose>
          <topic>/margdrishti/camera</topic>
          <update_rate>10</update_rate>
          <camera><horizontal_fov>1.05</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>30</far></clip></camera>
        </sensor>
      </link>
      <joint name="camera_joint" type="fixed"><parent>chassis</parent><child>camera_mount</child></joint>

      <link name="ultrasonic_sensor">
        <pose>0.23 0 0.01 0 0 0</pose>
        <inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="sensor_visual"><geometry><box><size>0.04 0.08 0.04</size></box></geometry><material><ambient>0.1 0.6 0.8 1</ambient></material></visual>
        <sensor name="obstacle_range" type="gpu_lidar">
          <pose>0.02 0 0 0 0 0</pose>
          <topic>/margdrishti/ultrasonic</topic>
          <update_rate>10</update_rate>
          <lidar><scan><horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal><vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan><range><min>0.05</min><max>4.0</max><resolution>0.01</resolution></range></lidar>
        </sensor>
      </link>
      <joint name="ultrasonic_joint" type="fixed"><parent>chassis</parent><child>ultrasonic_sensor</child></joint>
    </model>

    <model name="road_obstacle">
      <static>true</static><pose>1.2 0 0.15 0 0 0</pose>
      <link name="obstacle">
        <collision name="c"><geometry><box><size>0.25 0.35 0.30</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.25 0.35 0.30</size></box></geometry><material><ambient>0.9 0.2 0.05 1</ambient><diffuse>0.9 0.2 0.05 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
